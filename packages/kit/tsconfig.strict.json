{
    // THE FRAMEWORK'S COMPILER CONTRACT (ADR-0014 part 2). @sssb/kit ships TypeScript source, so its files are
    // compiled under the ADOPTER'S options, and `skipLibCheck` does not cover a `.ts` file. So the whole package
    // compiles under every option in the strict set and at the ES2022 lib floor: an adopter who turns any of
    // them on, or whose lib stops at ES2022, cannot break SSSB. Code that passes a flag still compiles with it
    // off. The set is the one pack and consume turns on in its consumer (STRICT_FLAGS,
    // scripts/pack-and-consume/checks.mjs), and tests/tooling/kit-strict.test.ts holds the two lists equal.
    // This is the fast, in-repo half of that promise; pack and consume proves it from the tarball.
    // `pnpm typecheck` runs it. The seam resolves to SSSB's own fixture (the root tsconfig's paths).
    // THE REST OF THE CONTRACT is what the root tsconfig gives it and an adopter's app must give it too; off any of
    // these, the framework's own files fail, measured from the tarball in the P3 review: `strict: true` (68 errors
    // with it off), `moduleResolution: "bundler"` (`nodenext` 665), `jsx: "react-jsx"` or `"preserve"`, always set
    // (`react` 644; unset, a server program reaching an email template fails), `dom` in `lib` for the components
    // (91 without it), and `skipLibCheck: true` (47 errors without it, all in dependencies' declarations). P4's
    // tsconfig base in @sssb/tools sets them; until then pack and consume writes them (`tsconfig-written`).
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "incremental": false,
        "lib": ["dom", "dom.iterable", "es2022"],
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noPropertyAccessFromIndexSignature": true,
        "erasableSyntaxOnly": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": []
}
