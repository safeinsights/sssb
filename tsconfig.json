{
    // The compiler contract (strict, bundler resolution, react-jsx, dom, skipLibCheck, the ES2022 floor) comes from
    // the base every SSSB app extends; this program raises `lib` for the repo's own scripts and tests.
    "extends": "@sssb/tools/tsconfig.base.json",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "incremental": true,
        // THE ROOT PROGRAM compiles the repo's shared code — tests/, scripts/, the configs, and the
        // WHOLE of packages/kit (its sources AND its colocated tests). So whatever `@sssb/app-config/*`
        // resolves to here is the seam SSSB's own suite is typechecked against, and pointing it at a
        // host app welds the framework's tests to that app: ejecting the demo used to leave `tsc`
        // red. It points at packages/kit/test-fixture instead — SSSB's own conforming seam, which no
        // adoption step can delete. Each app's tsconfig still points `@sssb/app-config/*` at its own
        // src/app-config, which is what makes apps/starter the framework's falsifier.
        // There is deliberately NO `@/*` here. It is an app's own alias, the ADR-0012 fence bans it
        // inside packages/kit, and nothing else the root program compiles may use it — so mapping it
        // could only ever point this program at a directory that `--eject-showcase` deletes. Leaving
        // it out is also one fewer file adoption has to rewrite: no path below names an app.
        "paths": {
            "@sssb/app-config/*": ["./packages/kit/test-fixture/app-config/*"],
            "@sssb/kit/*": ["./packages/kit/src/*"]
        }
    },
    "include": [
        "tests/**/*.ts",
        "scripts/**/*.ts",
        "*.ts",
        "*.mjs",
        "packages/seed/src/**/*.ts",
        "packages/kit/src/**/*.ts",
        "packages/kit/src/**/*.tsx",
        "packages/kit/test-fixture/**/*.ts",
        "packages/kit/test-fixture/**/*.tsx",
        "packages/tools/**/*.js",
        "packages/tools/**/*.ts"
    ],
    "exclude": ["node_modules", "apps", "spikes", "infra"]
}
