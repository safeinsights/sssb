{
    "name": "showcase",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "The showcase app: the demo product that exercises every SSSB capability (ADR-0007).",
    "scripts": {
        "dev": "NEXT_TELEMETRY_DISABLED=1 APP_MODE=simulated sssb dev-tick showcase -- next dev --port \"$(sssb port)\"",
        "tick": "sssb tick showcase",
        "dev:real": "export NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1 && APP_MODE=real sssb check-real-env && NEXT_TELEMETRY_DISABLED=1 APP_MODE=real next dev --port \"$(sssb port)\"",
        "llm:record": "tsx scripts/llm-record.ts",
        "build": "NEXT_TELEMETRY_DISABLED=1 next build",
        "start": "next start --port \"$(sssb port)\"",
        "panda:codegen": "panda codegen",
        "typecheck": "next typegen && tsc --noEmit",
        "sssb:doctor": "sssb doctor",
        "check:e2e": "sssb check-e2e",
        "test:e2e": "NEXT_TELEMETRY_DISABLED=1 playwright test --project=chromium && NEXT_TELEMETRY_DISABLED=1 playwright test --project=destructive --workers=1 --no-deps",
        "ladle": "PANDA_LOG_LEVEL=silent ladle serve --port \"$(sssb port ladle)\"",
        "build:e2e": "NEXT_TELEMETRY_DISABLED=1 E2E_BUILD=1 APP_MODE=simulated next build",
        "start:e2e": "E2E_BUILD=1 APP_MODE=simulated sssb serve-standalone",
        "build:demo": "NEXT_TELEMETRY_DISABLED=1 DEMO_MODE=1 APP_MODE=simulated next build",
        "start:demo": "DEMO_MODE=1 APP_MODE=simulated sssb serve-standalone",
        "build:demo-static": "vite build --config vite.demo.config.ts",
        "check:demo-size": "sssb check-demo-size 860000",
        "e2e:demo-static": "playwright test --config playwright.demo.config.ts"
    },
    "dependencies": {
        "@app/seed": "workspace:*",
        "@mantine/core": "^9.7.3",
        "@mantine/form": "^9.7.3",
        "@sentry/nextjs": "^11.12.0",
        "@sssb/kit": "workspace:*",
        "kysely": "^0.29.7",
        "next": "^16.4.6",
        "next-intl": "^4.14.9",
        "react": "~19.3.1",
        "react-dom": "~19.3.1",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@ladle/react": "^5.1.1",
        "@pandacss/dev": "^2.5.0",
        "@playwright/test": "^1.64.1",
        "@sssb/tools": "workspace:*",
        "@vitejs/plugin-react": "^6.1.2",
        "embedded-postgres": "18.4.0-beta.17",
        "postcss": "^8.5.31",
        "vite": "^8.3.5",
        "vite-plugin-singlefile": "^2.3.4",
        "vitest": "^4.1.12"
    },
    "sssb": {
        "port": "showcase"
    }
}
