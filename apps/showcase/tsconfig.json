{
    "extends": "@sssb/tools/tsconfig.base.json",
    "compilerOptions": {
        "incremental": true,
        "paths": {
            "@/*": ["./src/*"],
            "@sssb/app-config/*": ["./src/app-config/*"],
            "@sssb/kit/*": ["../../packages/kit/src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        ".ladle/**/*.ts",
        ".ladle/**/*.tsx",
        ".next/types/**/*.ts",
        "*.ts",
        "*.mjs",
        "config/**/*.ts",
        "scripts/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
