{
    "name": "starter",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "The starter app: the minimum an adopter keeps — one entity, one card, and an otherwise empty seam (ADR-0007, ADR-0012).",
    "scripts": {
        "dev": "NEXT_TELEMETRY_DISABLED=1 APP_MODE=simulated sssb dev-tick -- next dev --port \"$(sssb port)\"",
        "tick": "sssb tick",
        "build": "NEXT_TELEMETRY_DISABLED=1 next build",
        "start": "next start --port \"$(sssb port)\"",
        "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p infra",
        "sssb:doctor": "sssb doctor",
        "check:e2e": "sssb check-e2e",
        "test:e2e": "NEXT_TELEMETRY_DISABLED=1 playwright test",
        "build:e2e": "NEXT_TELEMETRY_DISABLED=1 E2E_BUILD=1 APP_MODE=simulated next build",
        "start:e2e": "E2E_BUILD=1 APP_MODE=simulated sssb serve-standalone",
        "build:demo-static": "vite build --config vite.demo.config.ts",
        "check:demo-size": "sssb check-demo-size 840000",
        "e2e:demo-static": "playwright test --config playwright.demo.config.ts"
    },
    "dependencies": {
        "@mantine/core": "^9.7.3",
        "@sssb/kit": "workspace:*",
        "kysely": "^0.29.7",
        "next": "^16.4.6",
        "next-intl": "^4.14.9",
        "react": "~19.3.1",
        "react-dom": "~19.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@sssb/tools": "workspace:*",
        "@vitejs/plugin-react": "^6.1.2",
        "embedded-postgres": "18.4.0-beta.17",
        "vite": "^8.3.5",
        "vite-plugin-singlefile": "^2.3.4"
    },
    "sssb": {
        "port": "starter"
    }
}
